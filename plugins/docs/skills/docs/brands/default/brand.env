# 기본 브랜드 (brands/default/brand.env)
# 회사 이름이 없는 중립 양식이다. build.sh 가 scaffold 에서 source 해 CSS 변수로 못 빼는
# @page 머리말 색과 표지 문구, 기밀 조항 기본값을 주입한다.
#
# 회사 양식이 필요하면 brands/<id>/ 를 만들고 같은 키를 채운다.
# BRAND_PRIMARY_HEX, BRAND_ACCENT_HEX, BRAND_FONT_STACK 은 brand.css 의
# --brand-primary, --brand-accent, --brand-font 와 같은 값이어야 한다.
# 값을 비우면 표지에서 그 자리가 사라진다(레이아웃 style.css 의 :empty 규칙).

# 표기명. <title> 접미사와 로고 alt 에 쓰고, logo.svg 가 없으면 글자 로고가 된다
BRAND_NAME=""

# 글자 로고에 쓸 문자열. 비우면 BRAND_NAME 을 쓴다
BRAND_WORDMARK=""

# 표지 로고 아래 태그라인
BRAND_TAGLINE=""

# 표지 하단의 법인명이나 작성 주체
BRAND_LEGAL=""

# 표지 '작성' 기본값 (COVER_FROM 미지정 시)
BRAND_FROM_DEFAULT=""

# 기밀 조항 기본값 (COVER_CONFIDENTIAL 미지정 시). 비우면 기밀 상자가 사라진다
BRAND_CONFIDENTIAL_DEFAULT=""

# 페이지 꼬리말과 표지 하단 표식. 비우면 표식 없음
BRAND_PAGE_MARK=""

# @page 영역 색과 폰트 (brand.css 토큰과 일치)
BRAND_PRIMARY_HEX="#2F5B8F"
BRAND_ACCENT_HEX="#9A8458"
BRAND_FONT_STACK="'Pretendard', 'Apple SD Gothic Neo', sans-serif"
